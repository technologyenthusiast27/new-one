# ─────────────────────────────────────────────────────────────
# NovaLabs.club — environment configuration
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
# From your Supabase project: Settings → API.
# The service-role key is SERVER-ONLY — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ──
# Get keys from https://dashboard.razorpay.com/app/keys
# Leaving these blank enables demo checkout (no real charge).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The public key id is exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email (SMTP via nodemailer) ──
# Any SMTP provider works (Gmail app password, Resend SMTP, Postmark, etc.)
# Leaving these blank disables real email; confirmations are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NovaLabs <tickets@novalabs.club>"

# ── Public site URL (used in QR ticket links & emails) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Security (all optional — features degrade gracefully when unset) ──
# Distributed rate limiting via Upstash Redis (falls back to per-instance
# in-memory limits when unset): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot protection on booking/login/guest-rename
# (widget + verification are skipped entirely when unset):
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin session lifetime (defaults: 60 minute idle, 12 hour absolute)
ADMIN_IDLE_TIMEOUT_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12
