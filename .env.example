# ─────────────────────────────────────────────────────────────
# HOUSE OF BALLOONS — environment configuration
# Copy this file to `.env.local` and fill in the values you have.
# Every integration below is OPTIONAL: with no keys the site runs
# in a self-contained DEMO mode (simulated payments, no real email).
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres via Prisma) ──
# Get a connection string from Vercel Postgres, Neon, or Supabase.
# Leaving this blank falls back to a local JSON file store (demo mode).
DATABASE_URL=

# ── Razorpay ──
# Get keys from https://dashboard.razorpay.com/app/keys
# Leaving these blank enables demo checkout (no real charge).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The public key id is exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email (SMTP via nodemailer) ──
# Any SMTP provider works (Gmail app password, Resend SMTP, Postmark, etc.)
# Leaving these blank disables real email; confirmations are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HOUSE OF BALLOONS <tickets@houseofballoons.live>"

# ── Admin dashboard ──
# Passphrase required to open /admin. Defaults to "wolves" in demo mode.
ADMIN_PASSCODE=wolves

# ── Public site URL (used in QR ticket links & emails) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
